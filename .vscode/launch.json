{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🚀 Start EBS Studio Web UI (Port 8855)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/ui/server_launcher.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "⚡ Start FastMCP Server (Claude / AI)",
      "type": "debugpy",
      "request": "launch",
      "module": "src.server",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "🧪 Run Pytest Test Suite",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-v"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "📄 Build Arabic Word Documentation (.docx)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/build_arabic_word_doc.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}
